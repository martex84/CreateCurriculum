{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@curriculum/*": ["./src/subdomains/curriculum/*"],
      "@routes/*": ["./src/routes/*"],
      "@templates/*": ["./src/subdomains/templates/*"],
      "@controllers/*": ["./src/infra/http/controllers/*"],
      "@factories/*": ["./src/main/factories/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
