{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@criacao_curriculo/*": ["./src/subdomains/criacao_curriculo/*"],
      "@routes/*": ["./src/routes/*"],
      "@geracao_templates/*": ["./src/subdomains/geracao_templates/*"],
      "@controllers/*": ["./src/infra/http/controllers/*"],
      "@factories/*": ["./src/main/factories/*"],
      "@shared/*": ["./src/shared/*"],
      "@config/*": ["./src/config/*"],
      "@tests/*": ["./src/tests/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "**/*.spec.ts"],
  "exclude": ["node_modules"]
}
